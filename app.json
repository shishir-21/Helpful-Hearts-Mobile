{
  "expo": {
    "name": "Helpful-Hearts",
    "slug": "helpful-hearts-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "helpfulhearts",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Helpful-Hearts uses your camera for doctor consultations.",
          "microphonePermission": "Helpful-Hearts uses your microphone for doctor consultations."
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.helpfulhearts.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.helpfulhearts.mobile",
      "bitcode": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bed6f2b2-9ee9-4210-96e9-713bc0e3362e"
      }
    },
    "owner": "shishir-21s-team"
  }
}
