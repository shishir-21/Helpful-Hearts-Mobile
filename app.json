{
  "expo": {
    "name": "Helpful-Hearts",
    "slug": "helpful-hearts-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "helpfulhearts",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Helpful-Hearts uses your camera for doctor consultations.",
          "microphonePermission": "Helpful-Hearts uses your microphone for doctor consultations."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.helpfulhearts.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.helpfulhearts.mobile"
    }
  }
}
